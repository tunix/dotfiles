{
  "$schema": "https://opencode.ai/v2/cli.json",

  "keybinds": {
{% for group, binds in opencode.cli.keybinds.items() %}
{% for action, key in binds.items() %}
    "{{ group }}.{{ action }}": "{{ key }}"{% if not loop.last %},{% endif %}

{% endfor %}
{% endfor %}
  },

  "attention": {
    "notifications": {{ opencode.cli.attention.notifications | lower }},
    "sound": {{ opencode.cli.attention.sound | lower }},
    "volume": {{ opencode.cli.attention.volume }}
  },
  "session": {
    "scrollbar": {{ opencode.cli.session.scrollbar | lower }},
    "sidebar": "{{ opencode.cli.session.sidebar }}"
  },
  "animations": {{ opencode.cli.animations | lower }},
  "tabs": {
    "layout": "{{ opencode.cli.tabs.layout }}"
  },
  "scroll": {
    "speed": {{ opencode.cli.scroll.speed }}
  }
}
