{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "servers": {
{% for name, server in opencode.mcp.items() %}
      "{{ name }}": {
        "type": "{{ server.type }}",
        "command": [
{% for arg in server.command %}
          "{{ arg }}"{% if not loop.last %},{% endif %}

{% endfor %}
        ],
        "disabled": {{ server.disabled | lower }}
      }{% if not loop.last %},{% endif %}

{% endfor %}
    }
  }
}
