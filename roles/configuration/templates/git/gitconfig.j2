[user]
    name = Alper Kanat
	email = me@alperkan.at
[color]
    branch = auto
    diff = auto
    status = auto
    ui = true
[core]
    whitespace=fix,-indent-with-non-tab,trailing-space,cr-at-eol
    pager = less -FXRS
    editor = {{ editor.name }}
    autocrlf = false
[init]
    defaultBranch = main
[alias]
    st = status
    ci = commit
    br = branch
    co = checkout
    df = diff -b
    dfc = diff -b --cached
    dfw = diff -b --word-diff
    lg = log -p --name-only
    lgg = log --graph
    lgf = log --graph --name-only
    ann = annotate
[push]
    # "tracking" pushed branches to their UPSTREAM, and autosetupmerge points
    # every branch created from a remote-tracking branch (origin/main) at
    # refs/heads/main — so `git push -u origin <fix-branch>` landed on main.
    # "simple" is git's default: same-name branches, and a bare push against a
    # differently-named upstream is rejected outright.
    default = simple
    # A branch without upstream is pushed to the same-named remote branch on
    # the first bare `git push`, which also sets its tracking — no -u needed,
    # and new branches can never accidentally target another branch's ref.
    autoSetupRemote = true
[merge]
    summary = true
[branch]
    # Track a remote branch on new-branch creation ONLY when the names match
    # (git >= 2.38). Branching fix/foo off origin/main therefore starts with
    # NO upstream; the same-name upstream comes from push.autoSetupRemote on
    # the first push instead.
    autosetupmerge = simple
[pull]
	rebase = false
[help]
    autocorrect = 10
[include]
    path = ~/.gitconfig.inc
