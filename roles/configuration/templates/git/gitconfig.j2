[user]
    name = Alper Kanat
	email = me@alperkan.at
[color]
    branch = auto
    diff = auto
    status = auto
    ui = true
[core]
    whitespace=fix,-indent-with-non-tab,trailing-space,cr-at-eol
    pager = less -FXRS
    editor = {{ editor.name }}
    autocrlf = false
[init]
    defaultBranch = main
[alias]
    st = status
    ci = commit
    br = branch
    co = checkout
    df = diff -b
    dfc = diff -b --cached
    dfw = diff -b --word-diff
    lg = log -p --name-only
    lgg = log --graph
    lgf = log --graph --name-only
    ann = annotate
[push]
    # "tracking" pushed branches to their UPSTREAM, and autosetupmerge points
    # every branch created from a remote-tracking branch (origin/main) at
    # refs/heads/main — so `git push -u origin <fix-branch>` landed on main.
    # "simple" is git's default: same-name branches, and a bare push against a
    # differently-named upstream is rejected outright.
    default = simple
[merge]
    summary = true
[branch]
    autosetupmerge = true
[pull]
	rebase = false
[help]
    autocorrect = 10
[include]
    path = ~/.gitconfig.inc
