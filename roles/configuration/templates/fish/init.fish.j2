if status is-login
    # disable greeting
    set -U fish_greeting

    # PATH is owned by ~/.config/environment.d (systemd user env) —
    # shell-independent; drop fish's own PATH overrides if any remain
    set -eU fish_user_paths

    # define XDG_CONFIG_HOME
    set -Ux XDG_CONFIG_HOME $HOME/.config

    # set EDITOR
    set -eg EDITOR
    set -Ux EDITOR {{ editor.name }}
end

if type -q atuin
    if not test -f $HOME/.config/fish/conf.d/atuin.fish
        atuin init fish > $HOME/.config/fish/conf.d/atuin.fish
        source $HOME/.config/fish/conf.d/atuin.fish
    end
end
