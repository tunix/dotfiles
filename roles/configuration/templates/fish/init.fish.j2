if status is-login
    # disable greeting
    set -U fish_greeting

    # add ~/.local/bin to PATH
    fish_add_path ~/.local/bin {{ shell.path }}

    # define XDG_CONFIG_HOME
    set -Ux XDG_CONFIG_HOME $HOME/.config

    # set EDITOR
    set -eg EDITOR
    set -Ux EDITOR {{ editor.name }}
end

if type -q atuin
    if not test -f $HOME/.config/fish/conf.d/atuin.fish
        atuin init fish > $HOME/.config/fish/conf.d/atuin.fish
        source $HOME/.config/fish/conf.d/atuin.fish
    end
end
