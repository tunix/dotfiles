if status is-interactive
    alias l1 "eza -1"
    alias ls "eza"
    alias ll "eza -l --icons=auto --group-directories-first"
    alias grep "ug"
    alias egrep "ug -E"
    alias fgrep "ug -F"
    alias xzgrep "ug -z"
    alias xzegrep "ug -zE"
    alias xzfgrep "ug -zF"
    alias cat "bat --style=plain --pager=never"
    alias v "nvim"
end
