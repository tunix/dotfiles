# macOS packages (formerly mac.yml `brew`). Cross-platform tools live in
# common/brew/. .pkg casks ask for the admin password themselves.
tap "esolitos/ipa", trusted: true # for sshpass
tap "hashicorp/tap", trusted: true

brew "bash"
brew "bat"
brew "eza"
brew "fish"
brew "fzf"
brew "gh"
brew "gnu-tar"
brew "hashicorp/tap/terraform"
brew "ipcalc"
brew "just"
brew "krew"
brew "openjdk@21"
brew "opentofu"
brew "sevenzip"
brew "sshpass"
brew "starship"
brew "telnet"
brew "ugrep"
brew "uptimed"
brew "watch"
brew "wget"
brew "zoxide"

cask "1password-cli"
cask "beekeeper-studio"
cask "font-jetbrains-mono"
